{
  "name": "onfilm-local-desktop",
  "productName": "OnFilm Local",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "electron test/persistence.cjs",
    "test:cloudflare-ui": "electron test/cloudflare-ui.cjs",
    "test:published-playback": "electron test/published-playback.cjs",
    "check:windows-runtime": "node scripts/check-windows-runtime.cjs",
    "prepare:windows-runtime": "node scripts/prepare-windows-runtime.cjs",
    "release:win": "node scripts/build-windows-installer.cjs",
    "pack:win": "electron-builder --config electron-builder.cjs --win --x64 --dir --publish never",
    "dist:win": "electron-builder --config electron-builder.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "hls.js": "1.7.3",
    "yauzl": "3.4.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "hash-wasm": "4.12.0"
  }
}
